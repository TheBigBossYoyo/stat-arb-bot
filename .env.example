# stat-arb-bot configuration template. Copy to .env (never commit .env).
# Every default is safe: offline, paper-only, no real orders possible.

APP_ENV=development
LOG_LEVEL=INFO

# --- live trading gate (BOTH must be true, plus --confirm-live on the CLI) ---
LIVE_TRADING=false
CONFIRM_LIVE_TRADING=false

# --- storage ---
DATABASE_URL=sqlite:///stat_arb.db

# --- Binance (testnet first: https://testnet.binance.vision) ---
# Create real keys trade-only (NEVER withdrawal-enabled), IP-restricted.
BINANCE_ENABLED=false
BINANCE_MODE=testnet
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_USE_FUTURES=false
BINANCE_MAX_LEVERAGE=1

# --- Trading 212 (demo first; official Public API = Invest/ISA only, no CFDs) ---
TRADING212_ENABLED=false
TRADING212_MODE=demo
TRADING212_API_KEY=
TRADING212_API_SECRET=
TRADING212_ACCOUNT_TYPE=invest
# Demo order submission requires this explicit flag AND --confirm-demo on the CLI.
TRADING212_ALLOW_DEMO_ORDERS=false
# LIVE orders are HARD-BLOCKED for this product: this flag is never consulted by
# the demo executor — a single env var cannot enable live (that path does not exist).
TRADING212_ALLOW_LIVE_ORDERS=false

# --- dashboard (read-only by default; keep host 127.0.0.1) ---
DASHBOARD_CONTROLS_ENABLED=false
DASHBOARD_TOKEN=

# --- optional risk-limit overrides (defaults live in app/config/risk_limits.yaml) ---
# MAX_DAILY_LOSS_PCT=2.0
# MAX_TOTAL_DRAWDOWN_PCT=10.0
